{
  "$id": "https://interactive-diagrams.dev/schemas/flow-document.schema.json",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "version",
    "title",
    "nodes",
    "edges"
  ],
  "properties": {
    "version": {
      "const": "1.0",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "views": {
      "minItems": 1,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "minLength": 1,
            "type": "string"
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "body"
        ],
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "anyOf": [
              {
                "const": "start",
                "type": "string"
              },
              {
                "const": "process",
                "type": "string"
              },
              {
                "const": "decision",
                "type": "string"
              },
              {
                "const": "end",
                "type": "string"
              }
            ]
          },
          "tone": {
            "anyOf": [
              {
                "const": "neutral",
                "type": "string"
              },
              {
                "const": "info",
                "type": "string"
              },
              {
                "const": "success",
                "type": "string"
              },
              {
                "const": "warning",
                "type": "string"
              },
              {
                "const": "danger",
                "type": "string"
              }
            ]
          },
          "title": {
            "minLength": 1,
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "source",
          "target"
        ],
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "source": {
            "minLength": 1,
            "type": "string"
          },
          "target": {
            "minLength": 1,
            "type": "string"
          },
          "label": {
            "minLength": 1,
            "type": "string"
          }
        }
      }
    },
    "highlights": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "nodeId",
          "field",
          "startOffset",
          "endOffset",
          "tone"
        ],
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "nodeId": {
            "minLength": 1,
            "type": "string"
          },
          "field": {
            "const": "body",
            "type": "string"
          },
          "startOffset": {
            "minimum": 0,
            "type": "integer"
          },
          "endOffset": {
            "minimum": 0,
            "type": "integer"
          },
          "tone": {
            "anyOf": [
              {
                "const": "info",
                "type": "string"
              },
              {
                "const": "success",
                "type": "string"
              },
              {
                "const": "warning",
                "type": "string"
              },
              {
                "const": "danger",
                "type": "string"
              }
            ]
          },
          "note": {
            "minLength": 1,
            "type": "string"
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "steps"
        ],
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "minLength": 1,
            "type": "string"
          },
          "viewId": {
            "minLength": 1,
            "type": "string"
          },
          "steps": {
            "minItems": 1,
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "id",
                "title",
                "body",
                "activeNodeIds",
                "activeEdgeIds"
              ],
              "properties": {
                "id": {
                  "minLength": 1,
                  "type": "string"
                },
                "title": {
                  "minLength": 1,
                  "type": "string"
                },
                "body": {
                  "minLength": 1,
                  "type": "string"
                },
                "activeNodeIds": {
                  "type": "array",
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "activeEdgeIds": {
                  "type": "array",
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
